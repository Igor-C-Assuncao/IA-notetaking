{
  "name": "ai-notetaking",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Igor Cassimiro Assunção",
  "repository": {
    "type": "git",
    "url": "https://github.com/Igor-C-Assuncao/IA-notetaking.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/tauri-wrapper.mjs",
    "sidecar:build:windows": "powershell -ExecutionPolicy Bypass -File scripts/build-windows-sidecar.ps1",
    "sidecar:build:windows:gpu": "powershell -ExecutionPolicy Bypass -File scripts/build-windows-sidecar-gpu.ps1",
    "sidecar:check": "node scripts/validate-sidecars.mjs",
    "engine:manifest": "node scripts/create-engine-release-manifest.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.0.4",
    "@vitest/ui": "^3.0.4",
    "jsdom": "^26.0.0",
    "msw": "^2.7.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.0.4"
  }
}
